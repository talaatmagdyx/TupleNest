normalizeHeader dup/long/odd                                     => ["name","name_2","name_3","column","column_2","c_1st","select","h_llo_w_rld","xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx","xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_2"]
batchRows(1..)                                                   => [[1,500],[131,500],[132,496],[1000,65],[1600,40],[70000,1]]
