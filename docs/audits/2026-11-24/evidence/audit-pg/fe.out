select id, name from users                                       => {"editable":true,"schema":"public","pk":[{"name":"id","index":0}],"writable":[false,true]}
select parent_id as id, name from users                          => {"editable":true,"schema":"public","pk":[{"name":"id","index":0}],"writable":[false,true]}
  -> delete built for aliased pk row (parent_id=7 shown as id)   => {"sql":"DELETE FROM \"public\".\"users\" WHERE \"id\" = $1::text::integer","params":["7"]}
select id + 1 as id, name from users                             => {"editable":true,"schema":"public","pk":[{"name":"id","index":0}],"writable":[false,true]}
select id, upper(name) as name from users                        => {"editable":true,"schema":"public","pk":[{"name":"id","index":0}],"writable":[false,true]}
select id, name from users u                                     => {"editable":true,"schema":"public","pk":[{"name":"id","index":0}],"writable":[false,true]}
select id, name from other.users                                 => {"editable":true,"schema":"other","pk":[{"name":"id","index":0}],"writable":[false,true]}
select * from nopk                                               => "nopk has no primary key"
select a, v from ck                                              => "add the primary key (b) to the result to edit it"
select a, b, v from ck                                           => {"editable":true,"schema":"public","pk":[{"name":"a","index":0},{"name":"b","index":1}],"writable":[false,false,true]}
select id, name from users order by name limit 10                => {"editable":true,"schema":"public","pk":[{"name":"id","index":0}],"writable":[false,true]}
select id, name from users tablesample system (10)               => {"editable":true,"schema":"public","pk":[{"name":"id","index":0}],"writable":[false,true]}
select id, name from users, generate_series(1,2)                 => "the query reads from more than one table"
select id, name from users cross join lateral (select 1) x       => "the query joins more than one table"
select id, name from only users                                  => "columns for only are not loaded yet"
select id, (select name from other.users o where o.id = users.id) as name from users => "more than one table is referenced"
select id, name from users where id in (select id from other.users) => "more than one table is referenced"
select id, unnest(array[name,name]) as name from users           => {"editable":true,"schema":"public","pk":[{"name":"id","index":0}],"writable":[false,true]}
select id, name from users for update                            => {"editable":true,"schema":"public","pk":[{"name":"id","index":0}],"writable":[false,true]}
