blank line in middle                                             => {"header":["a","b"],"rows":[["1","2"],[""],["3","4"]]}
trailing blank lines                                             => {"header":["a","b"],"rows":[["1","2"],[""],[""]]}
ragged rows                                                      => {"header":["a","b"],"rows":[["1"],["1","2","3"]]}
unterminated quote                                               => {"header":["a","b"],"rows":[["1,2\n3,4\n5,6\n"]]}
text after closing quote                                         => {"header":["a","b"],"rows":[["xy","p ","2"]]}
quote mid-field                                                  => {"header":["a","b"],"rows":[["5\" disk","x\"y\""]]}
embedded newline + escaped quote                                 => {"header":["a","b"],"rows":[["l1\r\nl2","say \"hi\""]]}
CR-only line endings                                             => {"header":["a","b1","23","4"],"rows":[]}
bare CR inside unquoted field                                    => {"header":["a","b"],"rows":[["foobar","2"]]}
empty vs quoted empty                                            => {"header":["a","b","c"],"rows":[["","\u0000"," "]]}
BOM                                                              => {"header":["a","b"],"rows":[["1","2"]]}
NUL byte value                                                   => {"header":["a"],"rows":[["\u0000"]]}
space before quote                                               => {"header":["a","b"],"rows":[[" \"x"," y\"","2"]]}
