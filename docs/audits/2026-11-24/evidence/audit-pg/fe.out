buildUpdate varchar(5) <- 'abcdefghij'                           => {"sql":"UPDATE \"public\".\"users\" SET \"name\" = $1::text::character varying(5) WHERE \"id\" = $2::text::integer AND \"name\" IS NOT DISTINCT FROM $3::text::character varying(5)","params":["abcdefghij","1","abc"]}
buildUpdate ts timestamp(3) with time zone                       => {"sql":"UPDATE \"public\".\"users\" SET \"ts\" = $1 WHERE \"id\" = $2::text::integer AND \"ts\" IS NOT DISTINCT FROM $3","params":["2024-01-01","1","2023-01-01T00:00:00Z"]}
buildUpdate numeric big                                          => {"sql":"UPDATE \"public\".\"users\" SET \"n\" = $1::text::numeric(6,2) WHERE \"id\" = $2::text::integer AND \"n\" IS NOT DISTINCT FROM $3::text::numeric(6,2)","params":["1234.567","9007199254740993","1.25"]}
previewSql                                                       => "UPDATE \"public\".\"users\" SET \"name\" = 'abcdefghij'::text::character varying(5) WHERE \"id\" = '1'::text::integer AND \"name\" IS NOT DISTINCT FROM 'abc'::text::character varying(5)"
